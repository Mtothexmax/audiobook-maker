{
	"name": "audioboook-maker",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"index-audio": "node scripts/generate-audio-catalog.js",
		"dev": "npm run index-audio && vite dev",
		"build": "npm run index-audio && vite build",
		"preview": "vite preview",
		"prepare": "npm run index-audio && (svelte-kit sync || echo '')",
		"check": "npm run index-audio && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"facesjs": "^5.0.3"
	}
}
