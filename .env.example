# Fish Audio API key used by the server-side TTS proxy (src/routes/api/tts/+server.ts).
# Get one at https://fish.audio → API keys.
# Optional: if unset, the key entered in the app's Settings dialog (stored in the
# browser) is forwarded instead. For production, set this and leave the UI key empty.
FISH_AUDIO_API_KEY=fa-xxxxxxxxxxxxxxxxxxxxxxxx
