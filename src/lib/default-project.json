  "tracks": [
    {
      "id": "track-104",
      "name": "Narration & Dialogue",
      "muted": false,
      "clips": [
        {
          "id": "d1",
          "type": "dialogue",
          "characterId": "char-126",
          "text": "The morning sun filtered through the spotless windows of the Verres-Evans household in Oxford, illuminating a kitchen table cluttered with academic journals and small electronic components.",
          "start": 0,
          "duration": 11.02,
          "rendered": true,
          "fadeIn": 0.4,
          "fadeOut": 0.3,
          "effects": [
            "Echo",
            "Reverb",
            "Loudness"
          ]
        },
        {
          "id": "d2",
          "type": "dialogue",
          "characterId": "char-124",
          "text": "[emotion:neutral] Harry, my boy, the post has arrived. Though I suspect your current book on game theory will have to pause for breakfast.",
          "start": 11.6,
          "duration": 8.28,
          "rendered": true,
          "fadeIn": 0,
          "fadeOut": 0,
          "effects": [
            "Echo",
            "Reverb",
            "Loudness"
          ]
        },
        {
          "id": "d3",
          "type": "dialogue",
          "characterId": "char-126",
          "text": "Resting quietly among the bills was an envelope made of thick, heavy parchment, addressed in striking emerald-green ink.",
          "start": 20.5,
          "duration": 8.7,
          "rendered": true,
          "fadeIn": 0.1,
          "fadeOut": 0.2,
          "effects": [
            "Echo",
            "Reverb",
            "Loudness"
          ]
        },
        {
          "id": "d4",
          "type": "dialogue",
          "characterId": "char-120",
          "text": "[emotion:curious] Fascinating. The structural integrity of this paper defies standard mass-production methods, and the ink composition is entirely anomalous.",
          "start": 29.8,
          "duration": 8.28,
          "rendered": true,
          "fadeIn": 0,
          "fadeOut": 0,
          "effects": [
            "Echo",
            "Reverb",
            "Loudness"
          ]
        },
        {
          "id": "d5",
          "type": "dialogue",
          "characterId": "char-124",
          "text": "[emotion:skeptical] Let me see that, Harry. Unless Oxford’s physics department has taken to elaborate practical jokes, I’d say we have an empirical impossibility on our hands.",
          "start": 38.7,
          "duration": 10.42,
          "rendered": true,
          "fadeIn": 0.2,
          "fadeOut": 0.2,
          "effects": [
            "Echo",
            "Reverb",
            "Loudness"
          ]
        },
        {
          "id": "d6",
          "type": "dialogue",
          "characterId": "char-126",
          "text": "Thus began a sequence of events that would test the very limits of human reason and scientific inquiry.",
          "start": 49.7,
          "duration": 6.24,
          "rendered": true,
          "fadeIn": 0.2,
          "fadeOut": 0.5,
          "effects": [
            "Echo",
            "Reverb",
            "Loudness"
          ]
        }
      ]
    },
